# Copy to apps/api/.env for `npm run dev`. Real environment variables take precedence.

# Port the API listens on.
PORT=3000
# development | test | production
NODE_ENV=development
# Comma-separated exact origins allowed to call the API from a browser (the web app).
CORS_ORIGINS=http://localhost:5173
# Reverse proxies in front of the API (e.g. 1 behind an AWS ALB). Used for client IPs in rate limiting.
TRUST_PROXY_HOPS=0

# Product data source (Fake Store). Leave unset to use the adapter default.
# FAKESTORE_BASE_URL=https://fakestoreapi.com
# Abort upstream requests after this many ms (-> 502).
UPSTREAM_TIMEOUT_MS=5000
# How long the product list is cached in memory (ms). 0 disables caching.
PRODUCT_CACHE_TTL_MS=300000
# Curated home-page products (exactly 5 ids), relative to the API working directory.
FEATURED_CONFIG_PATH=config/featured.json

# Email. Defaults target Mailpit (UI http://localhost:8025).
# For AWS SES: SMTP_HOST=email-smtp.<region>.amazonaws.com, SMTP_PORT=587, plus SMTP credentials.
SMTP_HOST=localhost
SMTP_PORT=1025
# true only for implicit TLS (port 465). STARTTLS on 587 uses false.
SMTP_SECURE=false
# true for real providers (SES on 587): refuse to send unless STARTTLS succeeds.
SMTP_REQUIRE_TLS=false
# Set both or neither. Never commit real values.
SMTP_USER=
SMTP_PASS=
# Required: where enquiries go, and the sender address.
SALES_INBOX=sales@example.com
MAIL_FROM=Product Catalogue <no-reply@example.com>

# Per client IP: at most MAX enquiries per WINDOW_MS.
ENQUIRY_RATE_LIMIT_MAX=5
ENQUIRY_RATE_LIMIT_WINDOW_MS=900000
