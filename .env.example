# Optional overrides for `docker compose up`. Copy to .env (gitignored). Every value has a default.

# Where enquiries are sent, and the sender address.
SALES_INBOX=sales@example.com
MAIL_FROM=Product Catalogue <no-reply@example.com>

# Swap Mailpit for a real SMTP provider (e.g. AWS SES) by changing these. Never commit credentials.
# SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=
# SMTP_PASS=

# Browser-facing URLs. Change both together if you change ports or hosts.
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:3000

ENQUIRY_RATE_LIMIT_MAX=5
ENQUIRY_RATE_LIMIT_WINDOW_MS=900000
